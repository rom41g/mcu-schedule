# Локальные секреты. Файл в .gitignore — в репозиторий не попадает.
# Заполните значения и НЕ коммитьте этот файл.

# Токен бота из @BotFather (тот, что выдан последним)
TG_TOKEN=

# Секрет вебхука — должен совпадать с TG_WEBHOOK_SECRET в настройках Worker
TG_WEBHOOK_SECRET=

# Сервисный токен ВК для парсинга расписания
VK_SERVICE_TOKEN=

# Админские значения (те же, что в Cloudflare Worker → Settings → Variables)
ADMIN_SECRET_KEY=
ADMIN_PASS=

# Telegram ID администратора: по нему мини-апп выдаёт права на удаление
# чужого ДЗ и открывает доступ к панели
ADMIN_TG_ID=671920144

# Ник администратора без «@» — запасной способ опознать его, если Telegram
# не отдал username в initData
ADMIN_TG_USERNAME=kommunalkamus

# ID канала для уведомлений о технических работах (бот должен быть
# администратором канала). Если пусто — уведомление уходит только в личку.
MAINTENANCE_CHANNEL_ID=

# Адрес мини-аппа для кнопки в Telegram и ссылок ВК
PUBLIC_APP_URL=

